{
  "name": "veilwalker-companion",
  "productName": "VeilWalker",
  "version": "0.1.0",
  "description": "VeilWalker companion app for Deadlock (overlay, companion, dashboard). Separate OS window only; never touches the game.",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "electron:install": "node node_modules/electron/install.js",
    "start": "node scripts/write-feed.js && electron .",
    "test": "node --test \"test/*.test.js\"",
    "tokens": "node scripts/gen-tokens.js",
    "feed": "node scripts/write-feed.js",
    "dist": "node scripts/write-feed.js && electron-builder --win nsis --x64 --publish never",
    "sums": "node scripts/sha256sums.js dist"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
