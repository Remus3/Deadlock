{
 "env": {
  "PYTHONIOENCODING": "utf-8",
  "PYTHONUTF8": "1",
  "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
 },
 "permissions": {
  "allow": [
   "Bash(git status:*)",
   "Bash(git log:*)",
   "Bash(git diff:*)",
   "Bash(python -m pytest:*)",
   "Bash(python tools/vw_paths.py:*)",
   "Bash(python tools/vw_privacy.py:*)",
   "Bash(python tools/vw_video.py check:*)",
   "Bash(python tools/vw_launch.py check:*)",
   "Bash(python tools/vw_lane.py status:*)",
   "Bash(gh run:*)"
  ],
  "deny": []
 },
 "hooks": {
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python ops/fleet_kit/fleet_done.py stop-hook",
      "timeout": 10
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "Bash|PowerShell|Read|Edit|Write|Grep|Glob|NotebookEdit|MultiEdit",
    "hooks": [
     {
      "type": "command",
      "command": "bash \"$CLAUDE_PROJECT_DIR/ops/fleet_kit/fleet_hook.sh\" fleet_subagent_first.py",
      "timeout": 15
     }
    ]
   },
   {
    "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
    "hooks": [
     {
      "type": "command",
      "command": "bash \"$CLAUDE_PROJECT_DIR/ops/fleet_kit/fleet_hook.sh\" fleet_claims.py hook",
      "timeout": 15
     }
    ]
   }
  ],
  "SubagentStop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python \"$CLAUDE_PROJECT_DIR/ops/fleet_kit/fleet_claims.py\" release-hook",
      "timeout": 10
     }
    ]
   }
  ]
 }
}
